<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>OAuth Client Credentials Test Site</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 2rem; }
        .container { max-width: 960px; margin: 0 auto; }
        .field { margin-bottom: 1rem; }
        label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
        input { width: 100%; padding: 0.5rem; font-family: Consolas, monospace; }
        button { padding: 0.6rem 1rem; font-weight: 600; }
        .ok { color: #0a7f2e; }
        .err { color: #b00020; }
        pre { background: #f6f8fa; padding: 1rem; overflow: auto; }
        .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-top: 1rem; }
        .muted { color: #666; }
    </style>
</head>
<body>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>