{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "DisplayName": "Token API"
  },
  "Jwt": {
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audiences": [
      "api://<protected-api-client-id>"
    ],
    "RequiredRole": "Api.Read"
  }
}